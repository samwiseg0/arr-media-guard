    the user's own, but no API key reads. None for an app that the user did not set up: no <APP>_API_KEY, no
    config.xml in app_dir(), and no URL or one of SHIPPED_URLS. A one-shot run says nothing of such an app."""
    key, url = app.upper(), (CFG.get(f"{app.upper()}_URL") or "").rstrip("/")
    return f"{key}_URL is set, but the {app.capitalize()} API key does not read: {mask(str(ex))[:150]}. Set {key}_API_KEY." \
        if url and url not in SHIPPED_URLS[app] else None


def app_list(app):
    """The first list call of a backfill or a scan, Radarr's movies or Sonarr's series. A run for an app that is not set
    stops here with one line that names the settings."""
    try:
        return arr(app, "movie" if app == "radarr" else "series")
    except FileNotFoundError as ex:   # api_key() found no key and no config.xml
        sys.exit(no_key(app, ex) or f"{app.capitalize()} is not set up. Set {app.upper()}_URL and {app.upper()}_API_KEY.")


# PATH_MAP='/tv:/media/tv|/movies:/media/movies' pairs the path an app uses with the path this script sees, as in Docker.
# SONARR_PATH_MAP, RADARR_PATH_MAP and PLEX_PATH_MAP pair the paths of one program the same way. Each one that is empty
# or missing takes PATH_MAP, see mapped().
MAP_KEYS = {"sonarr": "SONARR_PATH_MAP", "radarr": "RADARR_PATH_MAP", "plex": "PLEX_PATH_MAP"}


def path_map(key):
    """(pairs, error) of the map setting key. error is None when every pair is two absolute paths. Each path loses its
    trailing slashes, so a folder written as "/mnt/TV/" still maps itself. "/" stays "/"."""
    pairs = [pair.split(":") for pair in CFG.get(key, "").split("|") if pair]
    good = [tuple(x.rstrip("/") or "/" for x in p) for p in pairs if len(p) == 2 and p[0].startswith("/") and p[1].startswith("/")]
    side = "PLEX_PATH" if key == "PLEX_PATH_MAP" else "APP_PATH"
    return good, None if len(good) == len(pairs) else \
        f"{key} takes pairs {side}:LOCAL_PATH of absolute paths, joined by '|'. A pair that is not one is left out."


PATH_MAP, _error = path_map("PATH_MAP")
MAPS, _errors = {}, [_error] if _error else []   # MAPS holds the map of each program whose own setting has a pair
for _who, _key in MAP_KEYS.items():
    _pairs, _error = path_map(_key)
    _errors += [_error] if _error else []
    if _pairs:   # a value with no pair, such as '|', leaves the program on PATH_MAP
        MAPS[_who] = _pairs
PATH_MAP_ERROR = " ".join(_errors) or None   # every map's error. --serve refuses to start on it.
CONFIG_ERRORS += _errors


def map_key(who):
    """The setting whose map who takes, "sonarr", "radarr" or "plex": its own, else PATH_MAP. None when neither has a pair."""
    return MAP_KEYS[who] if who in MAPS else "PATH_MAP" if PATH_MAP else None


def map_fix(who):
    """What a message tells the user to change when the map of who does not fit: fix a map that is set, else set one."""
    key = map_key(who)
    return f"fix {key}" if key == MAP_KEYS[who] else f"fix PATH_MAP, or set {MAP_KEYS[who]}" if key else f"set {MAP_KEYS[who]} or PATH_MAP"


def mapped(x, who, back=False):
    """x with each path under a program prefix of who's map moved to its local prefix, in every string of a list or dict.
    who is "sonarr", "radarr" or "plex". back maps a local path to the program's path. The longest prefix wins, and a
    prefix matches whole folder names only."""
    pairs = MAPS.get(who, PATH_MAP)
    if not pairs:
        return x
    if isinstance(x, dict):
        return {k: mapped(v, who, back) for k, v in x.items()}
    if isinstance(x, list):
        return [mapped(v, who, back) for v in x]
    for a, b in sorted(pairs, key=lambda m: -len(m[back])) if isinstance(x, str) else ():
        src, dst = (b, a) if back else (a, b)
        if x == src or x.startswith(src.rstrip("/") + "/"):
            return dst.rstrip("/") + x[len(src.rstrip("/")):] or "/"
    return x


def app_query(path, app):
    """An API path whose query values are local paths, with those values mapped to the app's paths."""
    if not MAPS.get(app, PATH_MAP) or "?" not in path:
        return path
    base, q = path.split("?", 1)
    return base + "?" + urllib.parse.urlencode([(k, mapped(v, app, True)) for k, v in urllib.parse.parse_qsl(q, keep_blank_values=True)])


def arr(app, path):
    """GET from the local Sonarr or Radarr. The paths in the answer are the ones this script sees, see mapped()."""
    port = APPS[app]
    return mapped(http(f"{CFG.get(app.upper() + '_URL', f'http://127.0.0.1:{port}')}/api/v3/{app_query(path, app)}", headers={"X-Api-Key": api_key(app)},
                       timeout=60), app)


def arr_write(app, path, method, body=None):
    """A write to the local Sonarr or Radarr. The re-grabs and the rescan after a repack use it."""
    port = APPS[app]
    return mapped(http(f"{CFG.get(app.upper() + '_URL', f'http://127.0.0.1:{port}')}/api/v3/{app_query(path, app)}", method, mapped(body, app, True),
                       {"X-Api-Key": api_key(app)}, timeout=60), app)


def path_warnings():
    """Why a path map does not fit, as warnings. Each app whose API key reads names its root folders. A root folder
    this script does not see warns, and so does one that no Plex library folder holds or sits in. --selftest and the
    listener start print them, and neither fails on them. Plex libraries that hold no root folder never warn, so a
    music library or another host's library stays quiet."""
    out, roots = [], []
    for app in APPS:
        name = "Radarr" if app == "radarr" else "Sonarr"
        try:
            api_key(app)
        except (OSError, AttributeError):   # an app this host does not run has no key here
            continue
        try:
            local = [r["path"] for r in arr(app, "rootfolder")]
        except Exception as ex:
            out.append(mask(f"{name} did not answer, so its root folders are not checked: {type(ex).__name__}: {ex}")[:300])
            continue
        for r in local:
            roots.append((name, r))
            if not os.path.isdir(r):
                where = f"{name}'s root folder {r}" if mapped(r, app, True) == r else \
                    f"{r}, where {map_key(app)} puts {name}'s root folder {mapped(r, app, True)}"
                out.append(f"this script does not see {where}. Mount the media there, or {map_fix(app)}.")
    if not CFG["PLEX_URL"] or not roots:
        return out
    try:
        locs = [loc["path"].rstrip("/") for d in plex_get("/library/sections").get("Directory", []) for loc in d.get("Location", [])]
    except Exception as ex:
        return out + [mask(f"Plex did not answer, so its library folders are not checked: {type(ex).__name__}: {ex}")[:300]]
    for name, r in roots:
        p = mapped(r, "plex", True).rstrip("/")
        if not any(p == x or p.startswith(x + "/") or x.startswith(p + "/") for x in locs):
            where, fix = "" if p == r.rstrip("/") else f", which {map_key('plex')} puts at {p} in Plex", map_fix("plex")
            out.append(f"no Plex library folder holds {name}'s root folder {r}{where}. {fix[0].upper()}{fix[1:]}, so Plex finds the "
                       "files the hook edits.")
    return out


def mkvmerge(path):
    r = subprocess.run(["mkvmerge", "-J", path], capture_output=True, text=True, errors="replace", timeout=120)
    if r.returncode > 1:   # 1 means warnings, and the JSON is still complete
        raise RuntimeError("mkvmerge: " + (r.stdout + r.stderr).strip()[-300:])
    return json.loads(r.stdout)


def log(rec):
    """One line in the decision log, in one O_APPEND write. The kernel appends each write whole, so the lines of the
    job processes, a backfill and a scan never interleave."""
    line = json.dumps(dict(time=datetime.datetime.now().astimezone().isoformat(timespec="seconds"), instance=CFG["INSTANCE"], **rec))
    fd = os.open(CFG["LOG"], os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o666)
    try:
        os.write(fd, (mask(line) + "\n").encode())
    finally:
        os.close(fd)


def status(key, code, detail="", touch=True):
    """Record one check for Zabbix in status.json. The time limit passes through. Any other failure logs a warning
    line and never stops the job, because the status file is a signal only."""
    try:
        _, note = arr_status.record(CFG["STATE_DIR"], key, code, mask(detail or ""), touch=touch)
    except (arr_meta.OutOfTime, TimeoutError):
        raise
    except Exception as ex:
        note = f"arr_status: {type(ex).__name__}: {ex}"[:200]
    if note:
        try:
            log(dict(source="status", result="warning", note=mask(note)))
        except OSError:
            pass


