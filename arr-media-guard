def metadata(app, path, j, size, d, original, release, ctx, fresh=False, asked=None, nfo=None):
    """arr_meta's checks of one probed file against its item, ctx from movie_item() or episode_item(). Returns
    {"trusted", "expected", "other", "evidence", "tmdb"}. A TMDB failure reads as unknown. TMDB's status goes to
    status.json only after a live answer, because a cache hit says nothing about the key. fresh is a second check
    before a re-grab, see tmdb_ask(). asked is the tmdb_ask() the decision already made, so TMDB is asked once. nfo is
    the episode title of the release's NFO, see release_nfo_title(). It wins over the title in the release name."""
    trusted = arr_meta.trusted_duration(j, size, arr_meta.last_packet(path))
    token, ids = CFG.get("TMDB_TOKEN") or None, ctx.get("ids") or {}
    cache = os.path.join(CFG["STATE_DIR"], "tmdb-recheck.json" if fresh else "tmdb.json")
    expected, t0 = asked or tmdb_ask(app, ctx, fresh)
    code, why = arr_meta.tmdb_state(expected)
    if code not in ("found", "no_record") or arr_meta.DOWN.get("answered", 0) >= t0:
        status("tmdb", code, why)
    kind = "episode" if app == "sonarr" else "special" if (expected or {}).get("special") else "movie"
    name = release or os.path.basename(path)
    args = (d["tracks"], original, expected, trusted, ctx.get("listed") or 0, name, kind, ctx.get("year"), ctx.get("titles") or ())
    ev, other = arr_meta.wrong_content_evidence(*args, episode=episode_title(app, ctx, nfo, release, path) if kind == "episode" else None), None
    if kind != "episode" and ev["points"] and trusted.get("seconds"):   # another film matters only for a movie with a point already
        other = arr_meta.other_film(name, ids.get("tmdb"), trusted["seconds"], token=token, cache=cache)
        if other:
            ev = arr_meta.wrong_content_evidence(*args, other)
    return {"trusted": trusted, "expected": expected, "other": other, "evidence": ev, "tmdb": ev["tmdb"]}


def episode_title(app, ctx, nfo, release, path):
    """arr_meta.episode_title_verdict() of an episode file, or None when neither the NFO, the release name nor the
    file name gives a title. Only then does it read the series' episodes, unless ctx holds them, as in a backfill. A
    failed read is verdict "unknown", so the other checks still run. A file with no scene name has Sonarr's own name,
    and the alert says so, because Sonarr wrote that name in the order it had at the import."""
    name = release or os.path.basename(path)
    said, title = ("the release's NFO", nfo) if nfo else \
        ("the release's title" if release else "the file name's title", arr_meta.release_episode_title(name))
    if not title or not ctx.get("series_id"):
        return None
    try:
        eps = ctx.get("episodes") or arr(app, f"episode?seriesId={ctx['series_id']}")
    except Exception as ex:
        return {"kind": "episode_title", "verdict": "unknown", "points": 0, "why": mask(f"the episode list did not read: {type(ex).__name__}: {ex}")[:200]}
    return arr_meta.episode_title_verdict(title, eps, ctx.get("episode_ids") or (), name, [t for t, _ in ctx.get("titles") or ()], said,
                                          ctx.get("anime"))


NFO_MAX = 64 << 10   # bytes of a scene NFO that release_nfo_title() reads


def release_nfo_title(source, release=""):
    """The episode title of the scene NFO beside source, the file Sonarr imported from, or None. The NFO counts when its
    name is the video's, or when it is the one NFO in a folder named like the video or the release. A download folder
    that holds the NFOs of other releases gives none. The hook reads it at the event, because a usenet download folder
    can be gone when the worker runs. Any error gives None, so the import never fails on it."""
    try:
        folder, name = os.path.split(source)
        stem, nfos = os.path.splitext(name)[0].lower(), [n for n in os.listdir(folder) if n.lower().endswith(".nfo")]
        own = [n for n in nfos if n[:-4].lower() == stem] or \
            (nfos if len(nfos) == 1 and os.path.basename(folder).lower() in (stem, release.lower()) else [])
        if not own:
            return None
        if not os.path.isfile(os.path.join(folder, own[0])):   # open() of a FIFO would block the app's import
            return None
        with open(os.path.join(folder, own[0]), "rb") as f:
            raw = f.read(NFO_MAX)
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:   # a scene NFO is code page 437
            text = raw.decode("cp437")
        return arr_meta.nfo_episode_title(text)
    except Exception:
        return None


