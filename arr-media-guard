def own_version():
    """The first 12 hex of the sha256 of this script and of each module in LIB that is deployed. It changes only when
    the code does. A module that is not there is left out, so one missing optional module never hides the version."""
    h, lib = hashlib.sha256(), os.path.dirname(arr_decide.__file__)
    for path in [__file__] + [os.path.join(lib, n) for n in LIB]:
        try:
            with open(path, "rb") as f:
                h.update(f.read())
        except OSError:
            pass
    return h.hexdigest()[:12]


