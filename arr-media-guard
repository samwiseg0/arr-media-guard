"""The arr-media-guard command, which a Sonarr or Radarr Custom Script connection runs too. The code is the package
arr_media_guard beside this file, symlinks resolved. ARR_MEDIA_GUARD_LIB names another folder that holds the package.
arr-media-guard --help lists the modes."""
import os, sys

sys.path.insert(0, os.environ.get("ARR_MEDIA_GUARD_LIB") or os.path.dirname(os.path.realpath(__file__)))
from arr_media_guard import cli  # noqa: E402

cli.main(sys.argv[1:])
