def settings():
    """KEY='value' lines of the env file, with defaults for everything but the secrets."""
    folders = {"KEEP_DIR": ".arr-media-guard-originals", "HIDE_DIR": ".arr-media-guard-convert"}
    cfg = {"INSTANCE": os.uname().nodename, "LOG": "/var/log/arr-media-guard.jsonl", "STATE_DIR": "/var/lib/arr-media-guard",
           "PLEX_URL": "", "LID_DIR": "/opt/arr-media-guard-lid", "NAME": "arr-media-guard", **folders, **{k: "" for k in SECRETS}}
    try:
        for line in open(ENV_FILE):
            k, sep, v = line.strip().partition("=")
            if sep and not k.startswith("#"): cfg[k] = v.strip("'\"")
    except OSError:
        pass
    for k, default in folders.items():   # one hidden folder name, so the apps and Plex never scan it
        if cfg[k] in (".", "..") or not cfg[k].startswith(".") or "/" in cfg[k]: cfg[k] = default
    return cfg


