
# --- Docker. These lines come last, so they win over the defaults above. ---
LOG='/config/logs/arr-media-guard.jsonl'
# Mount a named volume here. The state store is SQLite in WAL mode and needs a local disk.
STATE_DIR='/config/state'
POLICY_FILE='/config/policy.json'
LID_DIR='/opt/arr-media-guard-lid'
# The name of this install in logs and alerts. The default, the host name, changes with each container.
INSTANCE='arr-media-guard'
# The apps as this container reaches them, for example by their compose service names.
RADARR_URL='http://radarr:7878'
SONARR_URL='http://sonarr:8989'
# Set RADARR_API_KEY and SONARR_API_KEY above, and for the subtitle hunter SABNZBD_API_KEY and NEWZNAB_API_KEY. The
# container reads the apps only through their APIs, so it needs no app config folder. Set SABNZBD_URL and
# NEWZNAB_URL above when the addresses Radarr has saved do not resolve from this container.
# Each instance of APP_INSTANCES above posts to /<name>, and reads its keys as this container reaches it. For example:
#SONARR_4K_URL='http://sonarr-4k:8989'
#SONARR_4K_API_KEY=''
#SONARR_4K_PATH_MAP=''
# The Webhook connection of each app sends these two. The listener does not start without them. Printable ASCII only.
# With KEEP_REPLACED='true', turn on On Grab in the Webhook connection too.
WEBHOOK_USER=''
WEBHOOK_PASSWORD=''
# Set the path maps above when this container sees the media at other paths than the apps do.
# The local time of the nightly audit, which also removes kept originals and grab links older than
# KEEP_ORIGINALS_DAYS, and of the weekly log rotation. Set TZ on the container. Empty: neither runs.
AUDIT_TIME='07:30'
