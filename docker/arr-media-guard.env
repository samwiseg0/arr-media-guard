# The Docker settings. docker/merge_env.py merges them into examples/arr-media-guard.env, and the image keeps the
# result. Each key here takes the place of the same key there, with the comment lines right above it. A key that the
# example does not hold goes to the end. A comment that a blank line parts from its key, as this one, is left out.

# --- Docker ---
# The user and password of the Webhook connection. Set the same pair as Username and Password in the Webhook connection
# of each app. Each takes any printable ASCII, and the user takes no ':'. When the password is empty, the listener
# generates one at its start and writes it here. A WEBHOOK_PASSWORD in the container's environment wins over this
# file, and the listener never writes one then.
WEBHOOK_USER='arr-admin'
WEBHOOK_PASSWORD=''
# The local time of the nightly audit, which also removes kept originals and grab links older than
# KEEP_ORIGINALS_DAYS, and of the weekly log rotation. Set TZ on the container. Empty: neither runs.
AUDIT_TIME='07:30'
LOG='/config/logs/arr-media-guard.jsonl'
# Mount a named volume here. The state store is SQLite in WAL mode and needs a local disk.
STATE_DIR='/config/state'
POLICY_FILE='/config/policy.json'
LID_DIR='/opt/arr-media-guard-lid'
# In Docker, the host name changes with each container.
INSTANCE='arr-media-guard'
# The apps as this container reaches them, for example by their compose service names.
RADARR_URL='http://radarr:7878'
SONARR_URL='http://sonarr:8989'
# This container reads the apps only through their APIs, so set both keys.
RADARR_API_KEY=''
SONARR_API_KEY=''
# In Docker, each instance posts to /<name>. Its URL is the address this container reaches, as 'http://sonarr-4k:8989'.
APP_INSTANCES=''
