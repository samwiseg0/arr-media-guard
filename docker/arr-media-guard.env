
# --- Docker. These lines come last, so they win over the defaults above. ---
LOG='/config/logs/arr-media-guard.jsonl'
STATE_DIR='/config/state'
POLICY_FILE='/config/policy.json'
LID_DIR='/opt/arr-media-guard-lid'
# The name of this install in logs and alerts. The default, the host name, changes with each container.
INSTANCE='arr-media-guard'
# The apps as this container reaches them, for example by their compose service names.
RADARR_URL='http://radarr:7878'
SONARR_URL='http://sonarr:8989'
# RADARR_DIR and SONARR_DIR keep their defaults, /var/lib/radarr and /var/lib/sonarr, where the compose file mounts each
# app's config folder read-only.
# The Webhook connection of each app sends these two. The listener does not start without them. Printable ASCII only.
WEBHOOK_USER=''
WEBHOOK_PASSWORD=''
# APP_PATH:LOCAL_PATH pairs joined by '|', when this container sees the media at other paths than the apps do.
# Plex must still see the files under the apps' paths. Empty: the same paths.
PATH_MAP=''
# The local time of the nightly audit, which also removes kept originals older than KEEP_ORIGINALS_DAYS, and of the
# weekly log rotation. Set TZ on the container. Empty: neither runs.
AUDIT_TIME='07:30'
