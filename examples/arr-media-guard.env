# The env file that arr-media-guard reads at start. A host install reads /etc/arr-media-guard.env. A Docker install
# reads /config/arr-media-guard.env.
# One KEY='value' a line. A comment needs its own line, because the value runs to the end of the line.
# It holds the Plex token, the Discord webhook and the TMDB key, so give it mode 0640.
# Every key is optional. A missing key takes the default shown here. An environment variable of the same name wins
# over a key here.

# --- Where things live ---
# The decision log, one JSON line per file.
LOG='/var/log/arr-media-guard.jsonl'
# The state store state.sqlite with the queue and the caches, the locks, the scan lists and status.json.
STATE_DIR='/var/lib/arr-media-guard'
POLICY_FILE='/etc/arr-media-guard.policy.json'
# The language detection venv and model. Detection runs only when LID_DIR/ready exists.
LID_DIR='/opt/arr-media-guard-lid'
# The syslog tag and the name in alert footers. It also names three hidden folders. .<NAME>-originals at the top of
# each mount holds kept originals, and .<NAME>-recycle beside it holds the files KEEP_REPLACED keeps. Where the hook
# cannot write the top of a mount, both go to the highest folder below it that it can write. .<NAME>-convert beside a
# video holds a remux's temp file, and the original and the extras during a conversion. Letters, digits, '.', '_' and
# '-' only.
NAME='arr-media-guard'
# The name of this host in logs and alerts. The default is the host name.
#INSTANCE='media1'

# --- Sonarr and Radarr ---
# An app counts as set up when its API key reads, from config.xml or the key below, or when you change its URL. A
# one-shot command says nothing of an app that is not set up.
RADARR_URL='http://127.0.0.1:7878'
SONARR_URL='http://127.0.0.1:8989'
# Each app's own folder. The script reads the API key from config.xml there. No feature reads the app's database.
RADARR_DIR='/var/lib/radarr'
SONARR_DIR='/var/lib/sonarr'
# The API key, for an app whose folder this host does not see, as in Docker. Empty: the key in config.xml.
RADARR_API_KEY=''
SONARR_API_KEY=''
# The address your browser opens for each app, as 'https://movies.example.com'. Each alert then links to the item
# there. Empty: no link.
RADARR_LINK=''
SONARR_LINK=''
# More instances, as name:program pairs joined by ','. A name holds letters and digits, with a single '-' between two
# of them, and the program is sonarr or radarr. The keys of an instance start with its name in upper case, with '-' as
# '_'. Its URL is required. Its folder defaults to /var/lib/<name>, and an empty map takes PATH_MAP. On a host with two
# instances of one program, set the Instance Name of each app to match, as 'Sonarr 4K' for sonarr-4k.
APP_INSTANCES=''
#APP_INSTANCES='sonarr-4k:sonarr,radarr-4k:radarr'
#SONARR_4K_URL='http://127.0.0.1:8990'
#SONARR_4K_API_KEY=''
#SONARR_4K_DIR='/var/lib/sonarr-4k'
#SONARR_4K_PATH_MAP=''
#SONARR_4K_LINK=''
#RADARR_4K_URL='http://127.0.0.1:7879'
#RADARR_4K_API_KEY=''
#RADARR_4K_DIR='/var/lib/radarr-4k'
#RADARR_4K_PATH_MAP=''
#RADARR_4K_LINK=''

# --- Plex, Discord and TMDB ---
# For example http://127.0.0.1:32400. Empty: no Plex call at all.
PLEX_URL=''
PLEX_TOKEN=''
# Alerts and scan summaries. Empty: nothing is posted.
DISCORD_WEBHOOK=''
# issues: a post for each problem left unresolved. all: also a post for each change to a file.
DISCORD_POSTS='issues'
# Empty: Radarr's TMDB key, read from /opt/Radarr/Radarr.Common.dll, else a copy of it in the code.
TMDB_TOKEN=''

# --- Path maps ---
# APP_PATH:LOCAL_PATH pairs joined by '|', when this script sees the media at other paths than the apps and Plex. A
# path may hold spaces. Empty: the same paths.
PATH_MAP=''
# The map of one program, when the programs see the media at different paths. Empty: PATH_MAP. Each instance of
# APP_INSTANCES has its own, as SONARR_4K_PATH_MAP. For example '/mnt/TV:/media/TV|/mnt/Anime:/media/Anime'.
SONARR_PATH_MAP=''
RADARR_PATH_MAP=''
PLEX_PATH_MAP=''

# --- Behaviour ---
# The kinds of fault that re-grab, joined by commas: audio (broken audio), video (corrupt video), content (wrong
# content) and damage (a damaged source that a conversion shows). A kind not listed only alerts "would re-grab".
# none turns every re-grab off. A blank value fails --selftest.
REGRAB='audio,video'
# Re-grabs per instance in 24 hours, then alerts only. Every kind shares the one count. 0 turns every re-grab off.
REGRAB_CAP='30'
# A re-grab of a broken upgrade puts back the old file from the recycle bin.
RESTORE='true'
# At each grab, hard-link the files the grab may replace into .<NAME>-recycle at the top of their mount, or in the
# highest folder below it that the hook can write. A restore uses this copy when the recycle bin has none. Turn on On
# Grab in the app's connection. Each copy stays for KEEP_ORIGINALS_DAYS. A value other than true or false keeps
# nothing, and --selftest fails on it.
KEEP_REPLACED='false'
# Remux a Matroska file whose header is wrong.
HEADER_REPAIR='true'
# What the subtitle check of an import does, with language detection. off: no check. check: it reads, reports and
# alerts, and changes nothing. fix: a subtitle of another episode leaves the file, such a sidecar moves to
# .<NAME>-originals, and late or flashing subtitles get new times. deep: fix, then a deep analysis after the import.
# The deep analysis reads the whole file for the subtitle tracks its index leaves out. It hears one window a minute,
# and it times the subtitles that had no reference yet. It runs only while no import waits, one file at a time, and
# costs about 3 CPU minutes for an episode. --sub-check and --sub-time ignore this setting.
SUBTITLES='fix'
# After an update, check again the files whose saved subtitle check the new version can improve. The first start of
# the version, or on a host its first nightly audit, queues one recheck per file. Each waits in the background queue
# behind the imports, and does what SUBTITLES allows. false turns it off. A value other than true or false acts as
# true, and --selftest fails on it.
RECHECK_ON_UPDATE='true'
# Days a repair keeps the file it replaced, and how long KEEP_REPLACED keeps its grab links. The nightly audit removes
# both after that, and the worker removes the grab links once a day too. 0 keeps nothing.
KEEP_ORIGINALS_DAYS='7'
# A larger file is never remuxed or converted.
REPACK_MAX_GB='30'
# Convert every imported file that is not Matroska into .mkv. A backfill converts only with --convert.
CONVERT='false'
# Conversions one --convert --apply run makes, then it stops.
CONVERT_MAX_FILES='200'
# Conversions a --convert --apply run makes at a time.
CONVERT_WORKERS='1'
# Files a library scan or a dry-run backfill reads at a time.
SCAN_WORKERS='1'
# Import jobs the hook runs at a time.
HOOK_WORKERS='1'

# --- Subtitle hunter ---
# The API keys of Radarr's SABnzbd download client and its Newznab indexer, such as NZBHydra2. Radarr's API hides
# both, so arr-media-guard-subhunt reads them here and stops without them.
SABNZBD_API_KEY=''
NEWZNAB_API_KEY=''
# SABnzbd and the indexer as this host reaches them, for example 'http://sabnzbd:8080' and 'http://nzbhydra2:5076'.
# Empty: the addresses Radarr has saved. Set them when those addresses do not resolve here.
SABNZBD_URL=''
NEWZNAB_URL=''
