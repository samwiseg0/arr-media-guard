# /etc/arr-media-guard.env, read by arr-media-guard at start.
# One KEY='value' a line. A comment needs its own line, because the value runs to the end of the line.
# It holds the Plex token, the Discord webhook and the TMDB key, so give it mode 0640.
# Every key is optional. A missing key takes the default shown here.

# --- Where things live ---
# The decision log, one JSON line per file.
LOG='/var/log/arr-media-guard.jsonl'
# The queue, the locks, the caches and status.json.
STATE_DIR='/var/lib/arr-media-guard'
POLICY_FILE='/etc/arr-media-guard.policy.json'
# The language detection venv and model. Detection runs only when LID_DIR/ready exists.
LID_DIR='/opt/arr-media-guard-lid'
# The folder at the top of each mount that holds kept originals. It must start with a dot.
KEEP_DIR='.arr-media-guard-originals'
# The folder beside the video that holds a remux's temp file, and the original and the extras during a conversion.
# It must start with a dot.
HIDE_DIR='.arr-media-guard-convert'
# The syslog tag and the name in alert footers.
NAME='arr-media-guard'
# The name of this host in logs and alerts. The default is the host name.
#INSTANCE='media1'

# --- Sonarr and Radarr. The script reads the API key from config.xml. ---
RADARR_URL='http://127.0.0.1:7878'
RADARR_CONFIG='/var/lib/radarr/config.xml'
SONARR_URL='http://127.0.0.1:8989'
SONARR_CONFIG='/var/lib/sonarr/config.xml'
# The subtitle hunter reads the download client and the indexer from this database.
RADARR_DB='/var/lib/radarr/radarr.db'

# --- Plex, Discord and TMDB ---
# For example http://127.0.0.1:32400. Empty: no Plex call at all.
PLEX_URL=''
PLEX_TOKEN=''
# Alerts and scan summaries. Empty: nothing is posted.
DISCORD_WEBHOOK=''
# Empty: Radarr's bundled TMDB key, read from /opt/Radarr/Radarr.Common.dll.
TMDB_TOKEN=''

# --- Behaviour ---
# Re-grabs per app in 24 hours for broken audio, wrong content and a damaged source, then alerts only.
REGRAB_CAP='30'
# Re-grabs per app in 24 hours for corrupt video.
VIDEO_REGRAB_CAP='30'
# false: a wrong-content file only alerts "would re-grab".
WRONG_CONTENT_REGRAB='false'
# Re-grab an import whose conversion shows a damaged source. false: a failed conversion only alerts "Repack failed",
# and a file ffprobe cannot read is only listed.
DAMAGE_REGRAB='true'
# A re-grab of a broken upgrade puts back the old file from the recycle bin.
RESTORE='true'
# Remux a Matroska file whose header is wrong.
HEADER_REPAIR='true'
# Compare each text subtitle and sidecar of an import with the audio, with language detection. A subtitle of another
# episode leaves the file, and such a sidecar moves to KEEP_DIR. A backfill runs the check only with --sub-check.
SUB_CHECK='true'
# Give a matching subtitle new times in a proven remux when its times are off. false: it alerts only.
SUB_TIMING='true'
# Days a repair keeps the file it replaced. 0 keeps nothing.
KEEP_ORIGINALS_DAYS='7'
# A larger file is never remuxed or converted.
REPACK_MAX_GB='30'
# Convert every imported file that is not Matroska into .mkv. A backfill converts only with --convert.
CONVERT='false'
# Conversions one --convert --apply run makes, then it stops.
CONVERT_MAX_FILES='200'
# Conversions a --convert --apply run makes at a time.
CONVERT_WORKERS='1'
# Files a library scan or a dry-run backfill reads at a time.
SCAN_WORKERS='1'
# Import jobs the hook runs at a time.
HOOK_WORKERS='1'
