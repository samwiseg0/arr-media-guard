# /etc/arr-media-guard.env, read by arr-media-guard at start.
# One KEY='value' a line. A comment needs its own line, because the value runs to the end of the line.
# It holds the Plex token, the Discord webhook and the TMDB key, so give it mode 0640.
# Every key is optional. A missing key takes the default shown here.

# --- Where things live ---
# The decision log, one JSON line per file.
LOG='/var/log/arr-media-guard.jsonl'
# The queue, the locks, the caches and status.json.
STATE_DIR='/var/lib/arr-media-guard'
POLICY_FILE='/etc/arr-media-guard.policy.json'
# The language detection venv and model. Detection runs only when LID_DIR/ready exists.
LID_DIR='/opt/arr-media-guard-lid'
# The syslog tag and the name in alert footers. It also names three hidden folders. .<NAME>-originals at the top of
# each mount holds kept originals, and .<NAME>-recycle beside it holds the files KEEP_REPLACED keeps. Where the hook
# cannot write the top of a mount, both go to the highest folder below it that it can write. .<NAME>-convert beside a
# video holds a remux's temp file, and the original and the extras during a conversion. Letters, digits, '.', '_' and
# '-' only.
NAME='arr-media-guard'
# The name of this host in logs and alerts. The default is the host name.
#INSTANCE='media1'

# --- Sonarr and Radarr ---
# An app counts as set up when its API key reads, from config.xml or the key below, or when you change its URL. A
# one-shot command says nothing of an app that is not set up.
RADARR_URL='http://127.0.0.1:7878'
SONARR_URL='http://127.0.0.1:8989'
# Each app's own folder. The script reads the API key from config.xml there. The conversion and the subtitle hunter
# read the app's database, radarr.db or sonarr.db, there too.
RADARR_DIR='/var/lib/radarr'
SONARR_DIR='/var/lib/sonarr'
# The API key, for an app whose folder this host does not see. Empty: the key in config.xml. The conversion and the
# subtitle hunter still need the folder.
RADARR_API_KEY=''
SONARR_API_KEY=''

# --- Plex, Discord and TMDB ---
# For example http://127.0.0.1:32400. Empty: no Plex call at all.
PLEX_URL=''
PLEX_TOKEN=''
# PLEX_PATH:LOCAL_PATH pairs joined by '|', when Plex sees the files under other paths than this script. A path may
# hold spaces, for example '/mnt/TV Shows:/media/TV'. Empty: PATH_MAP. Without both, Plex sees the files under the
# paths this script sees.
PLEX_PATH_MAP=''
# Alerts and scan summaries. Empty: nothing is posted.
DISCORD_WEBHOOK=''
# Empty: Radarr's bundled TMDB key, read from /opt/Radarr/Radarr.Common.dll.
TMDB_TOKEN=''

# --- Behaviour ---
# The kinds of fault that re-grab, joined by commas: audio (broken audio), video (corrupt video), content (wrong
# content) and damage (a damaged source that a conversion shows). A kind not listed only alerts "would re-grab".
# none turns every re-grab off. A blank value fails --selftest.
REGRAB='audio,video'
# Re-grabs per app in 24 hours, then alerts only. Every kind shares the one count. 0 turns every re-grab off.
REGRAB_CAP='30'
# A re-grab of a broken upgrade puts back the old file from the recycle bin.
RESTORE='true'
# At each grab, hard-link the files the grab may replace into .<NAME>-recycle at the top of their mount, or in the
# highest folder below it that the hook can write. A restore uses this copy when the recycle bin has none. Turn on On
# Grab in the app's connection. Each copy stays for KEEP_ORIGINALS_DAYS. A value other than true or false keeps
# nothing, and --selftest fails on it.
KEEP_REPLACED='false'
# Remux a Matroska file whose header is wrong.
HEADER_REPAIR='true'
# What the subtitle check of an import does, with language detection. off: no check. check: it reads, reports and
# alerts, and changes nothing. fix: a subtitle of another episode leaves the file, such a sidecar moves to
# .<NAME>-originals, and late or flashing subtitles get new times. deep: fix, then a deep analysis after the import: a
# read of the whole file for subtitle tracks its index leaves out, a sweep of one heard window a minute, and the timing
# of the subtitles that had no reference yet. It runs only while no import waits, one file at a time, and costs about
# 3 CPU minutes for an episode. --sub-check and --sub-time ignore this setting.
SUBTITLES='fix'
# Days a repair keeps the file it replaced, and how long KEEP_REPLACED keeps its grab links. The nightly audit removes
# both after that, and the worker removes the grab links once a day too. 0 keeps nothing.
KEEP_ORIGINALS_DAYS='7'
# A larger file is never remuxed or converted.
REPACK_MAX_GB='30'
# Convert every imported file that is not Matroska into .mkv. A backfill converts only with --convert.
CONVERT='false'
# Conversions one --convert --apply run makes, then it stops.
CONVERT_MAX_FILES='200'
# Conversions a --convert --apply run makes at a time.
CONVERT_WORKERS='1'
# Files a library scan or a dry-run backfill reads at a time.
SCAN_WORKERS='1'
# Import jobs the hook runs at a time.
HOOK_WORKERS='1'
